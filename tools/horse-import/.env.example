# Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.

# --- The tipster account (a normal login) ---
TIPSTER_EMAIL=
TIPSTER_PASSWORD=
# The members' login page (required), and the page that lists today's tips. Set TIPSTER_TIPS_URL once you know it
# (open the daily tips page in your browser and copy the address); without it the script looks for a "Daily tips" link.
TIPSTER_LOGIN_URL=
TIPSTER_TIPS_URL=

# --- GoalBrew ---
GOALBREW_URL=https://seashell-app-z8xl5.ondigitalocean.app
# A long random string. Set the SAME value as HORSE_IMPORT_KEY on the website's DigitalOcean component.
# It only opens the one route that receives the picks.
HORSE_IMPORT_KEY=

# --- Reading the page (optional until the site's layout is known; run with --debug first) ---
# When set, each ROW is one selection, and the others are looked up inside it. Leave empty to use the text guesser.
TIPS_ROW_SELECTOR=
TIPS_NAME_SELECTOR=
TIPS_ODDS_SELECTOR=
TIPS_COURSE_SELECTOR=
TIPS_TIME_SELECTOR=
EXPECTED_PICKS=4
# Only if the login form isn't found automatically:
# Leave empty. Set to yes ONLY if the site's security certificate has expired and you accept the risk: the password is
# then sent without checking who is on the other end.
TIPSTER_IGNORE_CERT_ERRORS=
TIPSTER_USER_SELECTOR=
TIPSTER_PASS_SELECTOR=
TIPSTER_SUBMIT_SELECTOR=

# --- Email alert on failure (optional; the phone notification works without it) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
